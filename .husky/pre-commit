#!/bin/sh
# Pre-commit hook: Block any VITE_ variable that looks like a secret key being committed
# This prevents accidentally baking API keys into the client-side bundle

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|env.*)$')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Patterns that indicate a secret is being stored in a VITE_ variable
SECRET_PATTERN='VITE_[A-Z_]*(API_KEY|SECRET|TOKEN|PASSWORD|PRIVATE)[A-Z_]*\s*=\s*.+'

FOUND=0
for FILE in $STAGED_FILES; do
  if git show ":$FILE" | grep -qE "$SECRET_PATTERN"; then
    echo ""
    echo "❌ SECURITY ERROR: Potential secret found in staged file: $FILE"
    echo "   Variables matching VITE_*API_KEY / VITE_*SECRET / VITE_*TOKEN / VITE_*PASSWORD are compiled"
    echo "   into the client-side JavaScript bundle and will be publicly visible."
    echo ""
    echo "   To fix: Move the secret to a Supabase Edge Function and read it via Deno.env.get()."
    echo "   The VITE_ prefix should only be used for non-sensitive public configuration values."
    echo ""
    FOUND=1
  fi
done

if [ "$FOUND" -eq 1 ]; then
  exit 1
fi

exit 0
